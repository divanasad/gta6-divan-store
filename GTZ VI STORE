<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DIVAN x GTA VI - Official Vice City Merch & Media Store</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Outfit:wght@300;400;600;800;900&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        vice: {
                            pink: '#ff007f',
                            cyan: '#00f0ff',
                            purple: '#28004d',
                            dark: '#0d021a',
                            card: 'rgba(30, 10, 50, 0.75)'
                        }
                    },
                    fontFamily: {
                        heading: ['"Bebas Neue"', 'sans-serif'],
                        sans: ['"Outfit"', 'sans-serif']
                    },
                    animation: {
                        'pulse-glow': 'pulseGlow 3s infinite alternate',
                        'float': 'float 6s ease-in-out infinite'
                    },
                    keyframes: {
                        pulseGlow: {
                            '0%': { filter: 'drop-shadow(0 0 15px rgba(255, 0, 127, 0.4))' },
                            '100%': { filter: 'drop-shadow(0 0 25px rgba(0, 240, 255, 0.8))' }
                        },
                        float: {
                            '0%, 100%': { transform: 'translateY(0px)' },
                            '50%': { transform: 'translateY(-10px)' }
                        }
                    }
                }
            }
        }
    </script>

    <style>
        body {
            background-color: #0d021a;
            color: #ffffff;
            font-family: 'Outfit', sans-serif;
            overflow-x: hidden;
        }

        /* Neon Glow Utility Effects */
        .text-glow-pink {
            text-shadow: 0 0 10px #ff007f, 0 0 20px #ff007f, 0 0 40px #ff007f;
        }
        .text-glow-cyan {
            text-shadow: 0 0 10px #00f0ff, 0 0 20px #00f0ff, 0 0 40px #00f0ff;
        }
        .box-glow-pink {
            box-shadow: 0 0 25px rgba(255, 0, 127, 0.35);
        }
        .box-glow-cyan {
            box-shadow: 0 0 25px rgba(0, 240, 255, 0.35);
        }
        .glass-panel {
            background: rgba(20, 5, 35, 0.65);
            backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 0, 127, 0.2);
        }
        .glass-card {
            background: linear-gradient(135deg, rgba(40, 10, 60, 0.6), rgba(15, 3, 25, 0.8));
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .glass-card:hover {
            border-color: #00f0ff;
            box-shadow: 0 0 20px rgba(0, 240, 255, 0.3);
        }
        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #0d021a;
        }
        ::-webkit-scrollbar-thumb {
            background: linear-gradient(to bottom, #ff007f, #00f0ff);
            border-radius: 4px;
        }
    </style>
</head>
<body class="selection:bg-vice-pink selection:text-white">

    <header class="fixed top-0 left-0 w-full z-50 transition-all duration-300 glass-panel border-b border-vice-pink/30">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-20">
                <!-- Logo -->
                <a href="#" class="flex items-center space-x-3 group">
                    <span class="font-heading text-4xl sm:text-5xl tracking-widest text-transparent bg-clip-text bg-gradient-to-r from-vice-pink via-purple-300 to-vice-cyan group-hover:scale-105 transition-transform duration-300 drop-shadow-[0_0_10px_rgba(255,0,127,0.8)]">
                        DIVAN <span class="text-vice-cyan font-extrabold italic">VI</span>
                    </span>
                </a>

                <!-- Desktop Nav -->
                <nav class="hidden md:flex items-center space-x-8 font-semibold tracking-wider text-sm uppercase">
                    <a href="#hero" class="text-gray-300 hover:text-vice-cyan transition-colors duration-200">Home</a>
                    <a href="#store" class="text-gray-300 hover:text-vice-pink transition-colors duration-200">Merch Store</a>
                    <a href="#gallery" class="text-gray-300 hover:text-vice-cyan transition-colors duration-200">Media Gallery</a>
                    <a href="#vip" class="text-gray-300 hover:text-vice-pink transition-colors duration-200">VIP Club</a>
                </nav>

                <!-- Actions: Cart Button -->
                <div class="flex items-center space-x-4">
                    <button id="cartBtn" onclick="toggleCart()" class="relative bg-gradient-to-r from-vice-pink to-purple-600 hover:from-vice-pink hover:to-vice-cyan text-white p-2.5 sm:px-5 sm:py-2.5 rounded-xl flex items-center space-x-2 shadow-lg hover:shadow-vice-pink/50 transition-all duration-300">
                        <i data-lucide="shopping-bag" class="w-5 h-5"></i>
                        <span class="hidden sm:inline font-bold tracking-wide">Cart</span>
                        <span id="cartCount" class="bg-vice-cyan text-vice-dark font-extrabold text-xs px-2 py-0.5 rounded-full shadow-inner">0</span>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <section id="hero" class="relative min-h-screen pt-24 flex items-center justify-center overflow-hidden bg-gradient-to-b from-vice-purple/40 via-vice-dark to-vice-dark">
        <!-- Background Ambient Video/Art simulation -->
        <div class="absolute inset-0 z-0 opacity-40">
            <img src="https://images.unsplash.com/photo-1509198397868-475647b2a1e5?auto=format&fit=crop&w=2000&q=80" class="w-full h-full object-cover mix-blend-overlay filter brightness-75 contrast-125" alt="Vice City Vibe">
            <div class="absolute inset-0 bg-gradient-to-t from-vice-dark via-transparent to-vice-dark/80"></div>
            <div class="absolute inset-0 bg-gradient-to-r from-vice-pink/20 via-transparent to-vice-cyan/20"></div>
        </div>

        <div class="relative z-10 max-w-5xl mx-auto px-4 text-center mt-12">
            <!-- Badge -->
            <div class="inline-flex items-center space-x-2 px-4 py-1.5 rounded-full glass-panel border border-vice-cyan/40 mb-6 animate-pulse-glow">
                <span class="w-2.5 h-2.5 rounded-full bg-vice-cyan animate-ping"></span>
                <span class="text-xs sm:text-sm uppercase font-bold tracking-widest text-vice-cyan">Official Pre-Order & Gear Drop</span>
            </div>

            <!-- Title -->
            <h1 class="font-heading text-6xl sm:text-8xl md:text-9xl tracking-tight leading-none text-white drop-shadow-[0_10px_20px_rgba(0,0,0,0.8)]">
                WELCOME TO <br>
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-vice-pink via-purple-300 to-vice-cyan text-glow-pink">LEONIDA STATE</span>
            </h1>

            <p class="mt-6 text-lg sm:text-xl text-gray-300 max-w-2xl mx-auto font-light leading-relaxed">
                Gear up for the most anticipated game release in history. Get official GTA VI physical discs, digital activation codes, hoodies, and Vice City exclusive collectibles.
            </p>

            <!-- CTA Buttons -->
            <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
                <a href="#store" class="w-full sm:w-auto px-8 py-4 rounded-xl bg-gradient-to-r from-vice-pink via-purple-600 to-vice-cyan font-bold text-lg uppercase tracking-wider text-white shadow-lg hover:shadow-vice-pink/60 transform hover:-translate-y-1 transition-all duration-300 text-center">
                    Explore Merch & Games
                </a>
                <a href="#gallery" class="w-full sm:w-auto px-8 py-4 rounded-xl glass-panel border border-vice-cyan/50 font-bold text-lg uppercase tracking-wider text-vice-cyan hover:bg-vice-cyan hover:text-vice-dark transform hover:-translate-y-1 transition-all duration-300 text-center">
                    Watch Trailers & Media
                </a>
            </div>
        </div>
    </section>

    <section id="store" class="py-24 relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Section Header -->
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
            <div>
                <h2 class="font-heading text-5xl sm:text-6xl tracking-wider text-transparent bg-clip-text bg-gradient-to-r from-vice-pink to-vice-cyan">
                    VICE CITY MERCH & CODES
                </h2>
                <p class="text-gray-400 mt-2 text-base sm:text-lg">Select your preferred platform, official apparel, or digital activation keys.</p>
            </div>
            
            <!-- Category Filter Tabs -->
            <div class="mt-6 md:mt-0 flex flex-wrap gap-2" id="filterTabs">
                <button onclick="filterProducts('all')" class="filter-btn active px-4 py-2 rounded-lg text-sm font-bold uppercase transition-all glass-panel border border-vice-pink text-vice-pink">All</button>
                <button onclick="filterProducts('games')" class="filter-btn px-4 py-2 rounded-lg text-sm font-bold uppercase transition-all glass-panel text-gray-300 hover:text-vice-cyan">Discs & Codes</button>
                <button onclick="filterProducts('apparel')" class="filter-btn px-4 py-2 rounded-lg text-sm font-bold uppercase transition-all glass-panel text-gray-300 hover:text-vice-pink">Apparel</button>
                <button onclick="filterProducts('accessories')" class="filter-btn px-4 py-2 rounded-lg text-sm font-bold uppercase transition-all glass-panel text-gray-300 hover:text-vice-cyan">Accessories</button>
            </div>
        </div>

        <!-- Products Grid -->
        <div id="productsGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
            <!-- Product Cards dynamic JavaScript insertion -->
        </div>
    </section>

    <section id="gallery" class="py-20 relative bg-vice-purple/20 border-y border-vice-pink/20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16">
                <h2 class="font-heading text-5xl sm:text-6xl tracking-wider text-white">
                    OFFICIAL MEDIA & SCREENSHOTS
                </h2>
                <p class="text-gray-400 mt-2">Explore high-resolution concept art, trailer stills, and character showcases.</p>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                <div class="group relative overflow-hidden rounded-2xl glass-card border border-white/10 aspect-video cursor-pointer" onclick="openGalleryModal('https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&fit=crop&w=1200&q=80', 'Vice City Neon Strip')">
                    <img src="https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&fit=crop&w=800&q=80" alt="Vice City Neon" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
                    <div class="absolute inset-0 bg-gradient-to-t from-vice-dark via-transparent opacity-80 group-hover:opacity-60 transition-opacity"></div>
                    <div class="absolute bottom-4 left-4">
                        <span class="text-xs uppercase tracking-widest text-vice-cyan font-bold">Screenshot</span>
                        <h4 class="text-lg font-bold text-white">Vice City Strip at Sunset</h4>
                    </div>
                </div>

                <div class="group relative overflow-hidden rounded-2xl glass-card border border-white/10 aspect-video cursor-pointer" onclick="openGalleryModal('https://images.unsplash.com/photo-1508739773434-c26b3d09e071?auto=format&fit=crop&w=1200&q=80', 'Jason & Lucia Artwork')">
                    <img src="https://images.unsplash.com/photo-1508739773434-c26b3d09e071?auto=format&fit=crop&w=800&q=80" alt="Lucia & Jason" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
                    <div class="absolute inset-0 bg-gradient-to-t from-vice-dark via-transparent opacity-80 group-hover:opacity-60 transition-opacity"></div>
                    <div class="absolute bottom-4 left-4">
                        <span class="text-xs uppercase tracking-widest text-vice-pink font-bold">Key Artwork</span>
                        <h4 class="text-lg font-bold text-white">Lucia & Jason Key Visual</h4>
                    </div>
                </div>

                <div class="group relative overflow-hidden rounded-2xl glass-card border border-white/10 aspect-video cursor-pointer" onclick="openGalleryModal('https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?auto=format&fit=crop&w=1200&q=80', 'Leonida Highway')">
                    <img src="https://images.unsplash.com/photo-1544620347-c4fd4a3d5957?auto=format&fit=crop&w=800&q=80" alt="Leonida Highway" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500">
                    <div class="absolute inset-0 bg-gradient-to-t from-vice-dark via-transparent opacity-80 group-hover:opacity-60 transition-opacity"></div>
                    <div class="absolute bottom-4 left-4">
                        <span class="text-xs uppercase tracking-widest text-vice-cyan font-bold">Environment</span>
                        <h4 class="text-lg font-bold text-white">Ocean Drive Coastline</h4>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="vip" class="py-24 relative max-w-5xl mx-auto px-4">
        <div class="glass-panel rounded-3xl p-8 sm:p-14 border border-vice-pink/40 text-center relative overflow-hidden box-glow-pink">
            <div class="relative z-10">
                <span class="text-vice-cyan uppercase font-bold tracking-widest text-sm">Exclusive Access</span>
                <h2 class="font-heading text-5xl sm:text-6xl text-white mt-2">JOIN THE DIVAN VI CREW</h2>
                <p class="text-gray-300 max-w-xl mx-auto mt-4 text-base sm:text-lg">
                    Subscribe for priority pre-order restocks, game key releases, and secret Vice City discount codes.
                </p>

                <form onsubmit="handleNewsletter(event)" class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3 max-w-md mx-auto">
                    <input type="email" id="newsletterEmail" required placeholder="Enter your email address" class="w-full px-5 py-3.5 rounded-xl bg-vice-dark/90 border border-white/20 text-white placeholder-gray-500 focus:outline-none focus:border-vice-cyan transition">
                    <button type="submit" class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-gradient-to-r from-vice-pink to-vice-cyan font-bold text-white uppercase tracking-wider hover:opacity-90 transition">
                        Join
