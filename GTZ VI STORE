    <footer class="border-t border-white/10 py-12 bg-vice-dark/90">
        <div class="max-w-7xl mx-auto px-4 text-center sm:text-left sm:flex sm:justify-between sm:items-center">
            <div>
                <p class="font-heading text-3xl text-transparent bg-clip-text bg-gradient-to-r from-vice-pink to-vice-cyan">DIVAN VI STORE</p>
                <p class="text-gray-500 text-sm mt-1">Fan merchandise & store platform created by Divan. Unofficial fan portal.</p>
            </div>
            <div class="mt-6 sm:mt-0 flex justify-center space-x-6 text-gray-400">
                <a href="#" class="hover:text-vice-cyan transition"><i data-lucide="twitter"></i></a>
                <a href="#" class="hover:text-vice-pink transition"><i data-lucide="instagram"></i></a>
                <a href="#" class="hover:text-vice-cyan transition"><i data-lucide="youtube"></i></a>
            </div>
        </div>
    </footer>

    <div id="cartModal" class="fixed inset-0 z-50 invisible opacity-0 transition-all duration-300">
        <!-- Backdrop -->
        <div onclick="toggleCart()" class="absolute inset-0 bg-black/80 backdrop-blur-sm"></div>

        <!-- Sidebar Content -->
        <div class="absolute right-0 top-0 h-full w-full max-w-md glass-panel border-l border-vice-pink/30 p-6 flex flex-col justify-between shadow-2xl">
            <div>
                <div class="flex items-center justify-between border-b border-white/10 pb-4">
                    <div class="flex items-center space-x-2">
                        <i data-lucide="shopping-bag" class="text-vice-pink"></i>
                        <h3 class="font-heading text-3xl text-white">Your Cart</h3>
                    </div>
                    <button onclick="toggleCart()" class="text-gray-400 hover:text-white"><i data-lucide="x"></i></button>
                </div>

                <!-- Items list -->
                <div id="cartItems" class="mt-6 space-y-4 max-h-[60vh] overflow-y-auto pr-2">
                    <!-- Dynamic Cart Items -->
                </div>
            </div>

            <!-- Footer / Total -->
            <div class="border-t border-white/10 pt-4 space-y-4">
                <div class="flex justify-between items-center text-lg font-bold">
                    <span class="text-gray-300">Total:</span>
                    <span id="cartTotal" class="text-2xl text-vice-cyan font-heading">€0.00</span>
                </div>
                <button onclick="checkout()" class="w-full py-4 rounded-xl bg-gradient-to-r from-vice-pink to-vice-cyan font-bold text-white text-center uppercase tracking-wider hover:opacity-90 transition shadow-lg shadow-vice-pink/40">
                    Proceed to Checkout
                </button>
            </div>
        </div>
    </div>

    <div id="galleryModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/90 p-4">
        <button onclick="closeGalleryModal()" class="absolute top-6 right-6 text-white hover:text-vice-pink"><i data-lucide="x" class="w-8 h-8"></i></button>
        <div class="max-w-4xl w-full text-center">
            <img id="galleryModalImg" src="" alt="Gallery Preview" class="w-full max-h-[80vh] object-contain rounded-xl border border-vice-cyan/30">
            <h3 id="galleryModalCaption" class="text-white text-xl font-bold mt-4"></h3>
        </div>
    </div>

    <script>
        // Sample Products Database
        const products = [
            {
                id: 1,
                name: "GTA VI PlayStation 5 Disc Edition",
                category: "games",
                price: 79.99,
                badge: "Pre-Order",
                image: "https://images.unsplash.com/photo-1606813907291-d86efa9b94db?auto=format&fit=crop&w=600&q=80",
                description: "Physical disc copy of GTA VI for PS5. Includes exclusive pre-order Vice City Map & Sticker Set."
            },
            {
                id: 2,
                name: "GTA VI Xbox Series X Disc Edition",
                category: "games",
                price: 79.99,
                badge: "Pre-Order",
                image: "https://images.unsplash.com/photo-1621259182978-fbf93132d53d?auto=format&fit=crop&w=600&q=80",
                description: "Physical copy for Xbox Series X. Includes exclusive physical Leonida state bonus voucher."
            },
            {
                id: 3,
                name: "PC Digital Activation Key (Rockstar Launcher)",
                category: "games",
                price: 69.99,
                badge: "Digital Code",
                image: "https://images.unsplash.com/photo-1550745165-9bc0b252726f?auto=format&fit=crop&w=600&q=80",
                description: "Instant activation key delivered via email on launch day. Fully playable on PC."
            },
            {
                id: 4,
                name: "Vice City Vice Hoodie - Magenta Cyber",
                category: "apparel",
                price: 59.99,
                badge: "Best Seller",
                image: "https://images.unsplash.com/photo-1556905055-8f358a7a47b2?auto=format&fit=crop&w=600&q=80",
                description: "Premium heavy cotton fleece hoodie featuring embroidered DIVAN VI Vice City palm design."
            },
            {
                id: 5,
                name: "Lucia & Jason Graphic Tee",
                category: "apparel",
                price: 29.99,
                badge: "New",
                image: "https://images.unsplash.com/photo-1521572267360-ee0c2909d518?auto=format&fit=crop&w=600&q=80",
                description: "100% vintage washed cotton shirt featuring full-front artwork of GTA VI protagonists."
            },
            {
                id: 6,
                name: "Leonida Metal License Plate Keychain",
                category: "accessories",
                price: 14.99,
                badge: "Accessory",
                image: "https://images.unsplash.com/photo-1584917865442-de89df76afd3?auto=format&fit=crop&w=600&q=80",
                description: "Stainless steel replica Vice City car license plate keychain."
            },
            {
                id: 7,
                name: "Vice City Sunset Metallic Poster Set (3x)",
                category: "accessories",
                price: 34.99,
                badge: "Limited",
                image: "https://images.unsplash.com/photo-1579783902614-a3fb3927b675?auto=format&fit=crop&w=600&q=80",
                description: "High-gloss metallic foil art posters showcasing Leonida locations."
            }
        ];

        let cart = [];

        // Render Products
        function renderProducts(items) {
            const grid = document.getElementById('productsGrid');
            grid.innerHTML = items.map(p => `
                <div class="glass-card rounded-2xl overflow-hidden flex flex-col justify-between transition-all duration-300">
                    <div>
                        <div class="relative h-52 overflow-hidden">
                            <img src="${p.image}" alt="${p.name}" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500">
                            <span class="absolute top-3 right-3 bg-vice-pink/90 text-white font-bold text-xs px-3 py-1 rounded-full uppercase tracking-wider backdrop-blur-sm">
                                ${p.badge}
                            </span>
                        </div>
                        <div class="p-5">
                            <h3 class="font-bold text-lg text-white line-clamp-1">${p.name}</h3>
                            <p class="text-gray-400 text-sm mt-2 line-clamp-2">${p.description}</p>
                        </div>
                    </div>
                    <div class="p-5 pt-0 flex items-center justify-between mt-4">
                        <span class="text-2xl font-heading text-vice-cyan">€${p.price.toFixed(2)}</span>
                        <button onclick="addToCart(${p.id})" class="bg-gradient-to-r from-vice-pink to-purple-600 hover:to-vice-cyan text-white p-3 rounded-xl transition-all duration-200">
                            <i data-lucide="plus" class="w-5 h-5"></i>
                        </button>
                    </div>
                </div>
            `).join('');
            lucide.createIcons();
        }

        // Filter Function
        function filterProducts(category) {
            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.classList.remove('border-vice-pink', 'text-vice-pink');
                btn.classList.add('text-gray-300');
            });
            event.target.classList.add('border-vice-pink', 'text-vice-pink');
            
            if (category === 'all') {
                renderProducts(products);
            } else {
                renderProducts(products.filter(p => p.category === category));
            }
        }

        // Cart Functions
        function addToCart(productId) {
            const item = products.find(p => p.id === productId);
            const existing = cart.find(c => c.id === productId);
            if (existing) {
                existing.qty++;
            } else {
                cart.push({ ...item, qty: 1 });
            }
            updateCartUI();
            toggleCart(true);
        }

        function removeFromCart(productId) {
            cart = cart.filter(c => c.id !== productId);
            updateCartUI();
        }

        function updateCartUI() {
            const cartItems = document.getElementById('cartItems');
            const cartCount = document.getElementById('cartCount');
            const cartTotal = document.getElementById('cartTotal');

            const totalCount = cart.reduce((sum, item) => sum + item.qty, 0);
            const totalPrice = cart.reduce((sum, item) => sum + (item.price * item.qty), 0);

            cartCount.innerText = totalCount;
            cartTotal.innerText = `€${totalPrice.toFixed(2)}`;

            if (cart.length === 0) {
                cartItems.innerHTML = `<p class="text-gray-400 text-center py-8">Your shopping cart is empty.</p>`;
            } else {
                cartItems.innerHTML = cart.map(item => `
                    <div class="flex items-center justify-between glass-card p-3 rounded-xl border border-white/5">
                        <div class="flex items-center space-x-3">
                            <img src="${item.image}" class="w-12 h-12 object-cover rounded-lg" alt="">
                            <div>
                                <h4 class="text-sm font-bold text-white max-w-[150px] truncate">${item.name}</h4>
                                <span class="text-xs text-vice-cyan font-bold">€${item.price.toFixed(2)} x ${item.qty}</span>
                            </div>
                        </div>
                        <button onclick="removeFromCart(${item.id})" class="text-gray-500 hover:text-vice-pink">
                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                        </button>
                    </div>
                `).join('');
            }
            lucide.createIcons();
        }

        function toggleCart(forceOpen = false) {
            const modal = document.getElementById('cartModal');
            if (forceOpen || modal.classList.contains('invisible')) {
                modal.classList.remove('invisible', 'opacity-0');
            } else {
                modal.classList.add('invisible', 'opacity-0');
            }
        }

        function checkout() {
            if(cart.length === 0) {
                alert("Your cart is empty!");
                return;
            }
            alert("Thank you for your order! This is a store template demo.");
            cart = [];
            updateCartUI();
            toggleCart();
        }

        // Lightbox Functions
        function openGalleryModal(imgUrl, caption) {
            document.getElementById('galleryModalImg').src = imgUrl;
            document.getElementById('galleryModalCaption').innerText = caption;
            document.getElementById('galleryModal').classList.remove('hidden');
            document.getElementById('galleryModal').classList.add('flex');
        }

        function closeGalleryModal() {
            document.getElementById('galleryModal').classList.add('hidden');
            document.getElementById('galleryModal').classList.remove('flex');
        }

        // Newsletter Form
        function handleNewsletter(e) {
            e.preventDefault();
            const msg = document.getElementById('newsletterMsg');
            msg.innerText = "Welcome to the crew! Check your inbox soon.";
            msg.classList.remove('hidden');
            document.getElementById('newsletterEmail').value = "";
        }

        // Initialize Page
        window.onload = function() {
            renderProducts(products);
            lucide.createIcons();
        };
    </script>
</body>
</html>
